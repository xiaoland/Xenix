{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Xenix Native: Debug App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_dev.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "PDM: install",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "XENIX_ENV": "development"
      }
    },
    {
      "name": "Xenix Native: Debug App (Workspace Home)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_dev.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "PDM: install",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "XENIX_APP_HOME": "${workspaceFolder}/.runtime",
        "XENIX_ENV": "development"
      }
    },
    {
      "name": "Xenix Native: Debug Smoke Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_dev.py",
      "args": [
        "--smoke-test"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "PDM: install",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "XENIX_APP_HOME": "${workspaceFolder}/.runtime-smoke"
      }
    }
  ]
}
