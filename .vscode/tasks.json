{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PDM: install",
      "type": "shell",
      "command": "pdm",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PDM: dev",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "AIMock: serve fixtures",
      "type": "shell",
      "command": "npx",
      "args": [
        "--yes",
        "@copilotkit/aimock",
        "--config",
        "aimock.json",
        "--port",
        "4010",
        "--host",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PDM: test",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PDM: check",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PDM: i18n extract",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "i18n-extract"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PDM: i18n compile",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "i18n-compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PDM: smoke",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "smoke"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PyInstaller: package",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "PDM: install",
        "PDM: check"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "PyInstaller: packaged smoke test",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "smoke-package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "PyInstaller: package"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: distribution zip",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "dist"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "PyInstaller: package"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
