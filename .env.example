# Root Environment Variables
# Copy this file to .env and fill in the values

# Development mode
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://xenix:xenix_dev_password@localhost:5435/xenix

# Python Configuration
PYTHON_EXECUTABLE=python3

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Backend Server Configuration
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:3000

# i18n Locale Base URL (for remote/CDN loading)
# Default: /locales/ (served from public directory)
# Production: https://cdn.example.com/locales/ (or your CDN URL)
VITE_LOCALE_BASE_URL=/locales/
