{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Word cloud for Xenix keyword or tag frequency results. Use with a registered dataset containing word and frequency columns; Xenix injects the dataset.",
  "width": 720,
  "height": 420,
  "padding": 8,
  "autosize": "none",
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {"data": "xenix_data", "field": "word"},
      "range": ["#d96c1c", "#3b6ea8", "#5e8c61", "#8a6fb0", "#6f6f6f", "#c17f1d"]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {"data": "xenix_data"},
      "encode": {
        "enter": {
          "text": {"field": "word"},
          "align": {"value": "center"},
          "baseline": {"value": "alphabetic"},
          "fill": {"scale": "color", "field": "word"}
        }
      },
      "transform": [
        {
          "type": "wordcloud",
          "size": [720, 420],
          "text": {"field": "word"},
          "font": "Microsoft YaHei",
          "fontSize": {"field": "datum.frequency"},
          "fontSizeRange": [12, 56],
          "fontWeight": {"value": 600},
          "padding": 2
        }
      ]
    }
  ]
}
