{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Word cloud for Xenix keyword or tag frequency results. Use with a registered dataset containing word and count columns; Xenix injects the dataset.",
  "width": 720,
  "height": 420,
  "padding": 8,
  "autosize": "none",
  "scales": [
    {
      "name": "wordcloud_color",
      "type": "ordinal",
      "domain": ["top", "mid", "tail"],
      "range": ["#1f4e79", "#4f7cac", "#b8c5d6"]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {"data": "xenix_data"},
      "encode": {
        "enter": {
          "text": {"field": "word"},
          "align": {"value": "center"},
          "baseline": {"value": "alphabetic"},
          "tooltip": {"signal": "datum.word + ': ' + datum.count"},
          "fill": {"scale": "wordcloud_color", "field": "rank_tier"}
        }
      },
      "transform": [
        {
          "type": "wordcloud",
          "size": [720, 420],
          "text": {"field": "word"},
          "font": "Microsoft YaHei, Noto Sans SC, Arial Unicode MS, sans-serif",
          "fontSize": {"field": "datum.count"},
          "fontSizeRange": [12, 56],
          "fontWeight": {"value": 600},
          "padding": 2,
          "rotate": {"field": "datum.angle"}
        }
      ]
    }
  ]
}
