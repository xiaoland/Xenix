{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Horizontal Top-N bar chart. Replace data.values with rows containing category and value.",
  "width": 680,
  "height": 360,
  "padding": {"left": 140, "right": 24, "top": 36, "bottom": 36},
  "autosize": "none",
  "title": {
    "text": "Top N 类别对比",
    "anchor": "start",
    "font": "Noto Sans SC, Inter, system-ui, sans-serif",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitle": "按数值从高到低排序"
  },
  "data": [
    {
      "name": "table",
      "values": [
        {"category": "A", "value": 120},
        {"category": "B", "value": 96},
        {"category": "C", "value": 73}
      ],
      "transform": [
        {"type": "collect", "sort": {"field": "value", "order": "descending"}}
      ]
    }
  ],
  "scales": [
    {
      "name": "yscale",
      "type": "band",
      "domain": {"data": "table", "field": "category"},
      "range": "height",
      "paddingInner": 0.18,
      "paddingOuter": 0.08
    },
    {
      "name": "xscale",
      "type": "linear",
      "domain": {"data": "table", "field": "value"},
      "nice": true,
      "range": "width",
      "zero": true
    }
  ],
  "axes": [
    {
      "orient": "left",
      "scale": "yscale",
      "labelFont": "Noto Sans SC, Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "domain": false,
      "ticks": false
    },
    {
      "orient": "bottom",
      "scale": "xscale",
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "grid": true,
      "gridOpacity": 0.18,
      "domain": false,
      "tickColor": "#ddd"
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "y": {"scale": "yscale", "field": "category"},
          "height": {"scale": "yscale", "band": 1},
          "x": {"scale": "xscale", "value": 0},
          "x2": {"scale": "xscale", "field": "value"},
          "fill": {"value": "#d96c1c"},
          "cornerRadiusTopRight": {"value": 4},
          "cornerRadiusBottomRight": {"value": 4},
          "tooltip": {"signal": "datum.category + ': ' + datum.value"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "xscale", "field": "value", "offset": 6},
          "y": {"scale": "yscale", "field": "category", "band": 0.5},
          "text": {"field": "value"},
          "baseline": {"value": "middle"},
          "fill": {"value": "#555"},
          "fontSize": {"value": 11},
          "font": {"value": "Inter, system-ui, sans-serif"}
        }
      }
    }
  ]
}
