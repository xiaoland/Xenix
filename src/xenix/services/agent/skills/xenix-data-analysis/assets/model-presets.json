{
  "version": "0.2.0",
  "classification": {
    "split": {
      "method": "train_test",
      "test_size": 0.2,
      "stratify": true,
      "random_seed": 42
    },
    "baseline": {
      "model_family": "logistic_regression",
      "preprocessing": {
        "numeric": "standardize",
        "categorical": "one_hot",
        "missing": "impute"
      },
      "params": {
        "penalty": "l2",
        "C": 1.0,
        "class_weight": "auto_if_imbalanced",
        "max_iter": 1000,
        "random_seed": 42
      },
      "metrics": ["confusion_matrix", "accuracy", "precision", "recall", "f1", "auc"]
    },
    "tune_candidates": [
      {
        "model_family": "logistic_regression",
        "grid": {
          "C": [0.1, 1.0, 10.0],
          "class_weight": [null, "balanced"]
        }
      },
      {
        "model_family": "random_forest_classifier",
        "grid": {
          "n_estimators": [200, 500],
          "max_depth": [5, 10, 20, null],
          "min_samples_leaf": [1, 5, 10],
          "max_features": ["sqrt", 0.5]
        }
      },
      {
        "model_family": "gradient_boosting_classifier",
        "grid": {
          "learning_rate": [0.03, 0.05, 0.1],
          "n_estimators": [100, 300, 500],
          "max_depth": [2, 3, 5]
        }
      }
    ]
  },
  "regression": {
    "split": {
      "method": "train_test",
      "test_size": 0.2,
      "random_seed": 42
    },
    "baseline": {
      "model_family": "ridge_regression",
      "preprocessing": {
        "numeric": "standardize",
        "categorical": "one_hot",
        "missing": "impute"
      },
      "params": {
        "alpha": 1.0,
        "random_seed": 42
      },
      "metrics": ["mae", "rmse", "r2"]
    },
    "tune_candidates": [
      {
        "model_family": "ridge_regression",
        "grid": {
          "alpha": [0.1, 1.0, 10.0, 100.0]
        }
      },
      {
        "model_family": "random_forest_regressor",
        "grid": {
          "n_estimators": [200, 500],
          "max_depth": [5, 10, 20, null],
          "min_samples_leaf": [1, 5, 10],
          "max_features": [0.6, 0.8, 1.0]
        }
      },
      {
        "model_family": "gradient_boosting_regressor",
        "grid": {
          "learning_rate": [0.03, 0.05, 0.1],
          "n_estimators": [100, 300, 500],
          "max_depth": [2, 3, 5]
        }
      }
    ]
  },
  "neural_network": {
    "classification": {
      "model_family": "mlp_classifier",
      "params": {
        "hidden_layer_sizes": [64, 32],
        "activation": "relu",
        "alpha": 0.001,
        "learning_rate_init": 0.001,
        "max_iter": 300,
        "early_stopping": true,
        "random_seed": 42
      }
    },
    "regression": {
      "model_family": "mlp_regressor",
      "params": {
        "hidden_layer_sizes": [64, 32],
        "activation": "relu",
        "alpha": 0.001,
        "learning_rate_init": 0.001,
        "max_iter": 300,
        "early_stopping": true,
        "random_seed": 42
      }
    },
    "small_grid": {
      "hidden_layer_sizes": [[32], [64], [64, 32]],
      "alpha": [0.0001, 0.001, 0.01],
      "learning_rate_init": [0.001],
      "early_stopping": [true]
    }
  }
}
