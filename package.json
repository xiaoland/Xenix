{
  "name": "xenix",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "electron:dev": "nuxt dev --no-fork",
    "electron:build": "nuxt build --prerender && electron-builder",
    "electron:build:win": "pnpm electron:build -- --win"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "1.4.6",
    "@nuxtjs/i18n": "10.2.1",
    "ant-design-vue": "^4.2.6",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.2.2",
    "nuxt-electron": "^0.7.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@unocss/nuxt": "^66.5.10",
    "@unocss/preset-icons": "^66.5.10",
    "electron": "^35.1.4",
    "electron-builder": "^24.13.3",
    "sass": "^1.97.0",
    "unocss": "^66.5.10",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.xenix.app",
    "productName": "Xenix",
    "asar": true,
    "directories": {
      "output": "dist-electron-pack",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      ".output/public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
