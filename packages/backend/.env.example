# Aliyun FC Deployment Environment Variables
#
# This file serves two purposes:
# 1. Documents required environment variables for s.yaml deployment
# 2. Template for FC console environment variable configuration
#
# Usage:
#   export $(cat .env.fc | xargs)
#   pnpm run deploy:all

# Environment
NODE_ENV=production

# Server (FC handles port binding internally)
BACKEND_PORT=9000
FRONTEND_URL=https://xenix.hadream.ltd

# Database (Use Aliyun RDS PostgreSQL)
DATABASE_URL=postgresql://username:password@your-rds-instance.aliyuncs.com:5432/xenix

# Redis (Use Aliyun Redis - for BullMQ if needed)
# REDIS_URL=redis://r-xxxxx.redis.rds.aliyuncs.com:6379

# Authentication
JWT_SECRET=ndklfhnpkdshiagfklnhvkjnhsjhcxjuoizuj

# Storage Configuration
STORAGE_TYPE=oss

# OSS Configuration (for presigned URLs and storage operations)
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=LTAI5t...
OSS_ACCESS_KEY_SECRET=your-secret-key
OSS_BUCKET=xenix-data
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_MOUNT_POINT=/mnt/oss

# OSS NAS Mount (for FC functions to access OSS as filesystem)
# This is the NAS server address that mounts your OSS bucket
# Format: {nas-file-system-id}.{region}.nas.aliyuncs.com
# Setup: Create NAS in Aliyun console, then mount OSS bucket to NAS
OSS_NAS_SERVER_ADDR=0123456-abc.cn-hangzhou.nas.aliyuncs.com

# File uploads
MAX_FILE_SIZE=104857600

# ML
PYTHON_PATH=/usr/bin/python3
ML_TIMEOUT=300000

# FC-specific (automatically set by FC, do not manually configure)
# FC_FUNC_CODE_PATH=/code
# FC_FUNCTION_VERSION=<version>

# Notes:
# - OSS NAS mount allows FC functions to access OSS bucket as local filesystem at /mnt/oss
# - Python workers read/write files directly from mounted OSS path
# - Backend uses ali-oss SDK for presigned URL generation
# - Never commit .env.fc with real credentials
