{
  "name": "@xenix/backend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "dotenv -c development -- tsx watch src/index.ts",
    "build": "tsup",
    "build:fc": "pnpm run build:shared && tsup --config tsup.config.fc.ts && pnpm run copy:assets",
    "build:shared": "cd ../shared && pnpm run build",
    "copy:assets": "node scripts/copy-assets.js",
    "copy:ml": "node scripts/copy-ml-to-workers.js",
    "package:fc": "pnpm run build:fc && node scripts/package-fc.js",
    "test:fc": "node scripts/test-fc-local.js",
    "build:layer": "node scripts/build-python-layer.js",
    "build:workers": "pnpm run copy:ml",
    "deploy:layer": "s deploy xenix-python-layer --use-local",
    "deploy:workers": "echo 'DEPRECATED: Use packages/ml-backend for ML worker deployment'",
    "deploy:backend": "pnpm run package:fc && s deploy xenix-backend --use-local",
    "deploy:all": "pnpm run build:layer && pnpm run build:workers && pnpm run package:fc && s deploy --all --use-local",
    "start": "node dist/index.js",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@alicloud/fc2": "^2.6.6",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.1",
    "@xenix/ml-backend": "workspace:*",
    "@xenix/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.38.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "pg": "^8.13.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.0",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "archiver": "^7.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "fs-extra": "^11.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
