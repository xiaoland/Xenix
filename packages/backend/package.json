{
  "name": "@xenix/backend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "dotenv -c development -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "tsx node_modules/.bin/drizzle-kit generate",
    "db:migrate": "tsx node_modules/.bin/drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.6.14",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.13.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "xlsx": "^0.18.5",
    "@xenix/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
