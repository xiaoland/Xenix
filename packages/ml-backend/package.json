{
  "name": "@xenix/ml-backend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/stdio": {
      "types": "./dist/adapters/stdio/index.d.ts",
      "default": "./dist/adapters/stdio/index.js"
    },
    "./adapters/aliyun-fc": {
      "types": "./dist/adapters/aliyun-fc/index.d.ts",
      "default": "./dist/adapters/aliyun-fc/index.js"
    },
    "./utils/logger": {
      "types": "./dist/utils/logger.d.ts",
      "default": "./dist/utils/logger.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:fc": "pnpm run build && pnpm run copy:python && pnpm run copy:workers",
    "copy:python": "node scripts/copy-python.js",
    "copy:workers": "node scripts/copy-to-workers.js",
    "deploy:layer": "s deploy xenix-ml-python-layer --use-local",
    "deploy:workers": "s deploy --all --use-local",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@xenix/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.13.1",
    "pino": "^9.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@serverless-devs/s": "^3.1.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "fs-extra": "^11.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
